# Rollback copies of the vendored FFmpeg / GDExtension binaries, kept beside the live ones whenever they
# are swapped (see the AV1 rebuild in STATE.md). Sixteen large files that duplicate whatever the previous
# release shipped — worth having on disk, never worth committing.
addons/ffmpeg/**/_backup-*/

# Bytecode from ad-hoc Python run inside the project tree.
__pycache__/
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.AppleDouble
.LSOverride
*~
*.swp
*.swo
*.bak
*.orig
/builds/
/dist/
/exports/
/reports/
addons/gdUnit4/GdUnitRunner.cfg
HANDOFF.md
export_presets.cfg
*.md
!CHANGELOG.md
!README.md

# ffmpeg/ffprobe are build inputs, not source. At 214 MiB each they exceed GitHub's 100 MiB
# per-file limit, and every future swap would add its full weight to clone size permanently.
# Published as a GitHub Release asset instead; see README for where to put them.
bin/*.exe
bin/ffmpeg.exe
bin/ffprobe.exe

# Local Godot editor unpack (do not commit the engine into the repo).
/Godot_v*/

# Local journey installs / pack backups (machine-specific).
/local/

# Ad-hoc Inferno scaffold helpers kept on disk, not part of the shipped tree.
/scripts/dev/scaffold_*.py
/scripts/dev/scaffold-*.ps1
/scripts/dev/restore_inferno_named_media.py

# Machine-local editor path (Godot Tools).
.vscode/

# Debug / Restim capture logs.
*.log
/debug-*.log
/restim_tcode*.log

# Local layout reference (keep on disk, do not commit).
/Erosphere_Inferno_layout.png
/Erosphere_Inferno_layout.png.import
